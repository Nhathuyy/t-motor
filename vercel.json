{
  "version": 2,
  "builds": [
    {
      "src": "dist/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/dist/index.html" },
    { "src": "/da-nang", "dest": "/dist/da-nang/index.html" },
    { "src": "/da-nang/", "dest": "/dist/da-nang/index.html" },
    { "src": "/nha-trang", "dest": "/dist/nha-trang/index.html" },
    { "src": "/nha-trang/", "dest": "/dist/nha-trang/index.html" },
    { "src": "/dalat", "dest": "/dist/dalat/index.html" },
    { "src": "/dalat/", "dest": "/dist/dalat/index.html" },
    { "src": "/en", "dest": "/dist/en/index.html" },
    { "src": "/en/", "dest": "/dist/en/index.html" },
    { "src": "/en/da-nang", "dest": "/dist/en/da-nang/index.html" },
    { "src": "/en/da-nang/", "dest": "/dist/en/da-nang/index.html" },
    { "src": "/en/nha-trang", "dest": "/dist/en/nha-trang/index.html" },
    { "src": "/en/nha-trang/", "dest": "/dist/en/nha-trang/index.html" },
    { "src": "/en/da-nang", "dest": "/dist/en/da-nang/index.html" },
    { "src": "/css/(.*)", "dest": "/dist/css/$1" },
    { "src": "/js/(.*)", "dest": "/dist/js/$1" },
    { "src": "/images/(.*)", "dest": "/dist/images/$1" },
    { "src": "/(.*)", "dest": "/dist/$1" }
  ]
}
