{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/da-nang", "dest": "/da-nang/index.html" },
    { "src": "/da-nang/", "dest": "/da-nang/index.html" },
    { "src": "/nha-trang", "dest": "/nha-trang/index.html" },
    { "src": "/nha-trang/", "dest": "/nha-trang/index.html" },
    { "src": "/dalat", "dest": "/dalat/index.html" },
    { "src": "/dalat/", "dest": "/dalat/index.html" },
    { "src": "/en/da-nang", "dest": "/en/da-nang/index.html" },
    { "src": "/en/da-nang/", "dest": "/en/da-nang/index.html" },
    { "src": "/en/nha-trang", "dest": "/en/nha-trang/index.html" },
    { "src": "/en/nha-trang/", "dest": "/en/nha-trang/index.html" },
    { "src": "/en/dalat", "dest": "/en/dalat/index.html" },
    { "src": "/en/dalat/", "dest": "/en/dalat/index.html" },
    { "src": "/en", "dest": "/en/index.html" },
    { "src": "/en/", "dest": "/en/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
